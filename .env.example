# DIR3 API Configuration

# Port for the API server (default: 3000)
PORT=3000

# API Tokens (comma-separated list)
# Generate secure tokens: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKENS=your-secret-token-1,your-secret-token-2,your-secret-token-3

# Example with multiple tokens:
# API_TOKENS=abc123def456,xyz789uvw012,client-a-token,client-b-token
